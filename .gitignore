# ==========================================
# ActivityTN Root .gitignore
# ==========================================

# ── Dependencies ──────────────────────────
node_modules/
*/node_modules/
package-lock.json.bak

# ── Environment & Secret Variables ────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*/.env
*/.env.*

# ── Expo & React Native ───────────────────
.expo/
.expo-shared/
dist/
web-build/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Android & iOS Builds
*.apk
*.aab
*.ipa
android/
ios/

# ── Backend Storage & Uploads ─────────────
backend/uploads/*
!backend/uploads/.gitkeep
backend/data/

# ── Logs & Debugging ──────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ── OS & System Files ─────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── IDEs & Editors ────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ── Temp & Local Runners ──────────────────
powershell.cmd
powershell.bat
*/powershell.cmd
*/powershell.bat
graphify-out/
.claude/
.system_generated/
