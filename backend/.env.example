NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/activitytn
CORS_ORIGIN=http://localhost:8081,http://localhost:5173

# Required in production: generate two distinct random values of at least 32 characters.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Comma-separated OAuth client IDs for official Google ID tokens. Keep empty to disable Google sign-in.
GOOGLE_CLIENT_IDS=

# Required for partner email verification; OTPs are never returned or logged.
RESEND_API_KEY=
RESEND_FROM=

# Optional local development administrator; password must contain at least 16 characters.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
